# Plain HTTP on the private network: TLS ends at Cloudflare and the tunnel (cloudflared) forwards here.
# Domains come from the environment (docker-compose.prod.yml).
{
	auto_https off
	admin 127.0.0.1:2019
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Panel and API on one origin (cookies stay first-party). Webhooks (Meta, Asaas) and the site's
# waitlist form also land here. The api trusts one proxy hop and reads the visitor's IP from
# X-Forwarded-For, set from Cloudflare's CF-Connecting-IP, and keeps Cloudflare's X-Forwarded-Proto
# (the edge is reachable only through the tunnel).
http://{$PANEL_DOMAIN}:80 {
	import common
	@api path /api/* /webhooks/* /health /ready
	handle @api {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		}
	}
	handle {
		root * /srv/web
		@shell path / /index.html /sw.js
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

http://www.{$SITE_DOMAIN}:80 {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

http://{$SITE_DOMAIN}:80 {
	import common
	root * /srv/site
	try_files {path} {path}/index.html
	file_server
}
