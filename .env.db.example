# Production database and backup settings (docker-compose.prod.yml: postgres and backup only).
# Copy to .env.db on the server. Never commit .env.db. Use hex values (openssl rand -hex 24): they go inside URLs.
POSTGRES_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_RUNTIME_PASSWORD=

# pgBackRest repository on Cloudflare R2 (RN-10). Bucket: private, created in the Cloudflare dashboard.
# Endpoint: <account id>.r2.cloudflarestorage.com (no https://). Region: auto.
# Key and secret: an R2 API token with Object Read & Write on that bucket only.
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_REGION=auto
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# Encrypts every backup and WAL file (RN-11). Generate once: openssl rand -base64 48
# KEEP A COPY OUTSIDE THE SERVER (password manager): without it no backup can be restored.
PGBACKREST_REPO1_CIPHER_PASS=
# Hour (UTC) of the nightly backup: full on Sundays, differential the other days. Default 06 (03:00 in Sao Paulo).
BACKUP_HOUR_UTC=06
