// Core data model: docs/spec/02-arquitetura.md (modelo de dados).
// Every business table has tenant_id + forced RLS (hand-written SQL in the migrations).
// Money in integer cents, instants in timestamptz.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------- Platform tables (no tenant_id, no RLS) ----------

model Tenant {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String
  plan              Plan         @default(essencial)
  status            TenantStatus @default(trial)
  timezone          String       @default("America/Sao_Paulo")
  specialtyPolicyId String?      @map("specialty_policy_id") @db.Uuid
  limits            Json         @default("{}")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  specialtyPolicy SpecialtyPolicy? @relation(fields: [specialtyPolicyId], references: [id], onDelete: Restrict)

  professionals     Professional[]
  channels          Channel[]
  services          Service[]
  availabilityRules AvailabilityRule[]
  timeOffs          TimeOff[]
  locations         Location[]
  knowledgeItems    KnowledgeItem[]
  contacts          Contact[]
  conversations     Conversation[]
  messages          Message[]
  inboundEvents     InboundEvent[]
  turns             Turn[]
  appointments      Appointment[]
  scheduledMessages ScheduledMessage[]
  payments          Payment[]
  aiUsages          AiUsage[]
  usageCounters     UsageCounter[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

/// Global catalog of rules per specialty (council rules). Read-only for the app.
model SpecialtyPolicy {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  specialty String   @unique
  rules     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenants Tenant[]

  @@map("specialty_policies")
}

enum Plan {
  essencial
  agenda
  pro
  clinica
}

enum TenantStatus {
  trial
  active
  restricted
  cancelled
}

// ---------- Business tables ----------

model Professional {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  toneOfVoice      String?  @map("tone_of_voice")
  messageExamples  String[] @default([]) @map("message_examples")
  googleCalendarId String?  @map("google_calendar_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  availabilityRules AvailabilityRule[] @relation("AvailabilityRule_professional")
  timeOffs          TimeOff[]          @relation("TimeOff_professional")
  appointments      Appointment[]      @relation("Appointment_professional")

  @@unique([tenantId, id])
  @@map("professionals")
}

model Channel {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  kind           ChannelKind
  status         ChannelStatus @default(pending)
  displayPhone   String?       @map("display_phone")
  phoneNumberId  String?       @map("phone_number_id")
  wabaId         String?       @map("waba_id")
  coexistence    Boolean       @default(false)
  gatewaySession String?       @map("gateway_session")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  conversations Conversation[] @relation("Conversation_channel")
  inboundEvents InboundEvent[] @relation("InboundEvent_channel")

  @@unique([tenantId, id])
  @@map("channels")
}

enum ChannelKind {
  cloud_api
  qr_gateway
}

enum ChannelStatus {
  pending
  connected
  disconnected
}

model Service {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  durationMinutes  Int      @map("duration_minutes")
  priceCents       Int      @map("price_cents")
  visibleToPatient Boolean  @default(true) @map("visible_to_patient")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  appointments Appointment[] @relation("Appointment_service")

  @@unique([tenantId, id])
  @@map("services")
}

/// Weekly wall-clock rule, interpreted in the tenant's timezone.
model AvailabilityRule {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  professionalId      String   @map("professional_id") @db.Uuid
  weekday             Int      @db.SmallInt
  startTime           DateTime @map("start_time") @db.Time(0)
  endTime             DateTime @map("end_time") @db.Time(0)
  slotIntervalMinutes Int      @default(0) @map("slot_interval_minutes")
  minNoticeMinutes    Int      @default(120) @map("min_notice_minutes")
  maxAdvanceDays      Int      @default(60) @map("max_advance_days")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  professional Professional @relation("AvailabilityRule_professional", fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, professionalId])
  @@map("availability_rules")
}

model TimeOff {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz
  endsAt         DateTime @map("ends_at") @db.Timestamptz
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  professional Professional @relation("TimeOff_professional", fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, professionalId, startsAt])
  @@map("time_off")
}

model Location {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  name                String
  address             String
  arrivalInstructions String?  @map("arrival_instructions")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  appointments Appointment[] @relation("Appointment_location")

  @@unique([tenantId, id])
  @@map("locations")
}

model KnowledgeItem {
  id        String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  question  String
  answer    String?
  source    KnowledgeSource @default(manual)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, active])
  @@map("knowledge_items")
}

enum KnowledgeSource {
  manual
  unanswered
  history
}

/// RF-23b: resolved by bsuid first, then by phone_key (E.164 with the Brazilian
/// mobile ninth digit removed, so both forms are the same contact).
model Contact {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  bsuid     String?
  phoneE164 String?   @map("phone_e164")
  phoneKey  String?   @map("phone_key")
  name      String?
  consents  Json      @default("{}")
  optOutAt  DateTime? @map("opt_out_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  conversations     Conversation[]     @relation("Conversation_contact")
  appointments      Appointment[]      @relation("Appointment_contact")
  scheduledMessages ScheduledMessage[] @relation("ScheduledMessage_contact")

  @@unique([tenantId, id])
  @@unique([tenantId, bsuid])
  @@unique([tenantId, phoneKey])
  @@map("contacts")
}

model Conversation {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  channelId        String              @map("channel_id") @db.Uuid
  contactId        String              @map("contact_id") @db.Uuid
  control          ConversationControl @default(ai)
  controlReason    String?             @map("control_reason")
  controlChangedAt DateTime            @default(now()) @map("control_changed_at") @db.Timestamptz
  pauseExpiresAt   DateTime?           @map("pause_expires_at") @db.Timestamptz
  windowExpiresAt  DateTime?           @map("window_expires_at") @db.Timestamptz
  turnVersion      Int                 @default(0) @map("turn_version")
  unreadCount      Int                 @default(0) @map("unread_count")
  lastMessageAt    DateTime?           @map("last_message_at") @db.Timestamptz
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  channel Channel @relation("Conversation_channel", fields: [tenantId, channelId], references: [tenantId, id], onDelete: Restrict)
  contact Contact @relation("Conversation_contact", fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)

  messages          Message[]          @relation("Message_conversation")
  turns             Turn[]             @relation("Turn_conversation")
  scheduledMessages ScheduledMessage[] @relation("ScheduledMessage_conversation")
  aiUsages          AiUsage[]          @relation("AiUsage_conversation")

  @@unique([tenantId, id])
  @@unique([tenantId, channelId, contactId])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

enum ConversationControl {
  ai
  human
}

model Message {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  channelId         String           @map("channel_id") @db.Uuid
  direction         MessageDirection
  author            MessageAuthor
  type              MessageType
  text              String?
  media             Json?
  providerMessageId String?          @map("provider_message_id")
  providerTimestamp DateTime?        @map("provider_timestamp") @db.Timestamptz
  status            MessageStatus
  errorCode         String?          @map("error_code")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation Conversation @relation("Message_conversation", fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, channelId, providerMessageId])
  @@index([tenantId, conversationId, providerTimestamp])
  @@map("messages")
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageAuthor {
  patient
  ai
  human
  system
}

enum MessageType {
  text
  audio
  image
  document
  sticker
  location
  interactive_reply
  template
  unsupported
}

enum MessageStatus {
  received
  pending
  sent
  delivered
  read
  failed
}

model InboundEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  channelId   String?   @map("channel_id") @db.Uuid
  provider    String
  payload     Json
  payloadHash String    @map("payload_hash")
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  error       String?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  channel Channel? @relation("InboundEvent_channel", fields: [tenantId, channelId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, payloadHash])
  @@map("inbound_events")
}

model Turn {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  version        Int
  messageIds     String[]  @default([]) @map("message_ids") @db.Uuid
  state          TurnState @default(pending)
  model          String?
  costMicroUsd   BigInt    @default(0) @map("cost_micro_usd")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation Conversation @relation("Turn_conversation", fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)

  aiUsages AiUsage[] @relation("AiUsage_turn")

  @@unique([tenantId, id])
  @@index([tenantId, conversationId, version])
  @@map("turns")
}

enum TurnState {
  pending
  running
  draft
  sent
  discarded
  failed
}

/// `during` is a tstzrange; Prisma cannot read or write it, so appointments go
/// through typed raw SQL (E-20). The exclusion constraint also lands in E-20.
model Appointment {
  id             String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  professionalId String                   @map("professional_id") @db.Uuid
  contactId      String                   @map("contact_id") @db.Uuid
  serviceId      String                   @map("service_id") @db.Uuid
  locationId     String?                  @map("location_id") @db.Uuid
  during         Unsupported("tstzrange")
  status         AppointmentStatus        @default(scheduled)
  googleEventId  String?                  @map("google_event_id")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  professional Professional @relation("Appointment_professional", fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Restrict)
  contact      Contact      @relation("Appointment_contact", fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  service      Service      @relation("Appointment_service", fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  location     Location?    @relation("Appointment_location", fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  scheduledMessages ScheduledMessage[] @relation("ScheduledMessage_appointment")
  payments          Payment[]          @relation("Payment_appointment")

  @@unique([tenantId, id])
  @@index([tenantId, professionalId])
  @@map("appointments")
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
  no_show
}

model ScheduledMessage {
  id             String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  contactId      String                @map("contact_id") @db.Uuid
  appointmentId  String?               @map("appointment_id") @db.Uuid
  conversationId String?               @map("conversation_id") @db.Uuid
  kind           ScheduledMessageKind
  templateName   String?               @map("template_name")
  sendAt         DateTime              @map("send_at") @db.Timestamptz
  state          ScheduledMessageState @default(scheduled)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contact      Contact       @relation("ScheduledMessage_contact", fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)
  appointment  Appointment?  @relation("ScheduledMessage_appointment", fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  conversation Conversation? @relation("ScheduledMessage_conversation", fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, sendAt])
  @@map("scheduled_messages")
}

enum ScheduledMessageKind {
  reminder
  confirmation
  follow_up
}

enum ScheduledMessageState {
  scheduled
  sent
  cancelled
  failed
}

/// Patient deposit (Fase 4). The money goes to the professional's own account.
model Payment {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  appointmentId    String?       @map("appointment_id") @db.Uuid
  amountCents      Int           @map("amount_cents")
  provider         String
  providerChargeId String?       @map("provider_charge_id")
  status           PaymentStatus @default(pending)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation("Payment_appointment", fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, appointmentId])
  @@map("payments")
}

enum PaymentStatus {
  pending
  held
  paid
  expired
  refunded
}

model AiUsage {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  conversationId    String?  @map("conversation_id") @db.Uuid
  turnId            String?  @map("turn_id") @db.Uuid
  task              String
  provider          String
  model             String
  inputTokens       Int      @default(0) @map("input_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  costMicroUsd      BigInt   @default(0) @map("cost_micro_usd")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation("AiUsage_conversation", fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  turn         Turn?         @relation("AiUsage_turn", fields: [tenantId, turnId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("ai_usage")
}

model UsageCounter {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  month              DateTime @db.Date
  conversations      Int      @default(0)
  messagesByCategory Json     @default("{}") @map("messages_by_category")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, month])
  @@map("usage_counters")
}

/// Append-only (RN-07): the app role may insert and read, never update or delete.
model AuditLog {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorType String   @map("actor_type")
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("audit_log")
}
