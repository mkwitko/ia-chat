/// Platform table (no RLS): onboarding invite created by the operator (owner decision, 25/11/2026:
/// account creation is invite-only). Only the SHA-256 of the token is stored. "Expired" is derived
/// from expires_at; a resend replaces the hash, so the old link stops working.
model OnboardingInvite {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash    String       @unique @map("token_hash")
  practiceName String       @map("practice_name")
  email        String?
  status       InviteStatus @default(pending)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz
  /// Operator who created it, and the last one who resent or cancelled it (platform audit).
  createdById  String       @map("created_by_id") @db.Uuid
  updatedById  String?      @map("updated_by_id") @db.Uuid
  usedAt       DateTime?    @map("used_at") @db.Timestamptz
  usedByUserId String?      @map("used_by_user_id") @db.Uuid
  tenantId     String?      @map("tenant_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@map("onboarding_invites")
}

enum InviteStatus {
  pending
  used
  cancelled
}
