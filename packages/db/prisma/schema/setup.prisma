// What the professional configures: services, hours, places, knowledge.

model Professional {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  toneOfVoice      String?  @map("tone_of_voice")
  messageExamples  String[] @default([]) @map("message_examples")
  /// The four tone questions as answered in the panel; tone_of_voice is derived from them.
  toneAnswers      Json     @default("{}") @map("tone_answers")
  googleCalendarId String?  @map("google_calendar_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  availabilityRules AvailabilityRule[]    @relation("AvailabilityRule_professional")
  timeOffs          TimeOff[]             @relation("TimeOff_professional")
  appointments      Appointment[]         @relation("Appointment_professional")
  services          ProfessionalService[] @relation("ProfessionalService_professional")

  @@unique([tenantId, id])
  @@map("professionals")
}

/// E-24b. offered: waiting for the owner; requested: asked Meta, webhooks arriving; declined: the
/// owner said no here; unavailable: the owner did not share it in the Business app (Meta 2593109).
enum HistoryImportState {
  none
  offered
  requested
  declined
  unavailable
  done
}

model Channel {
  id                  String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  kind                ChannelKind
  status              ChannelStatus      @default(pending)
  displayPhone        String?            @map("display_phone")
  phoneNumberId       String?            @map("phone_number_id")
  wabaId              String?            @map("waba_id")
  coexistence         Boolean            @default(false)
  gatewaySession      String?            @map("gateway_session")
  /// Business token from the Embedded Signup code exchange, encrypted (META_TOKEN_KEY).
  accessTokenEnc      String?            @map("access_token_enc")
  /// Two-step verification PIN we set when registering the number, encrypted.
  registerPinEnc      String?            @map("register_pin_enc")
  /// Embedded Signup steps already done at Meta (subscribed, registered, templates, payment_method).
  setupDone           String[]           @default([]) @map("setup_done")
  /// Meta error code of the last failed step; null when the last run went through.
  setupError          String?            @map("setup_error")
  /// E-24b: where the coexistence history import stands (none for numbers without coexistence).
  historyImport       HistoryImportState @default(none) @map("history_import")
  /// When the coexistence onboarding finished: Meta allows the sync request for 24 h from here.
  onboardedAt         DateTime?          @map("onboarded_at") @db.Timestamptz
  /// When the owner authorized the import in the panel (the request to Meta follows at once).
  historyAuthorizedAt DateTime?          @map("history_authorized_at") @db.Timestamptz
  /// Share of the history received so far (0 to 100), from the `history` webhooks.
  historyProgress     Int?               @map("history_progress")
  /// When the owner confirmed or discarded the staged import; later history webhooks are ignored.
  historyReviewedAt   DateTime?          @map("history_reviewed_at") @db.Timestamptz
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  conversations Conversation[]     @relation("Conversation_channel")
  inboundEvents InboundEvent[]     @relation("InboundEvent_channel")
  metaUsages    MetaMessageUsage[] @relation("MetaMessageUsage_channel")
  routes        ChannelRoute[]     @relation("ChannelRoute_channel")

  @@unique([tenantId, id])
  @@map("channels")
}

/// Platform table (no RLS): a webhook arrives before any tenant is known, identified only
/// by the provider account (Cloud API phone_number_id or WABA id). One account, one channel.
model ChannelRoute {
  accountId String   @id @map("account_id")
  tenantId  String   @map("tenant_id") @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  channel Channel @relation("ChannelRoute_channel", fields: [tenantId, channelId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, channelId])
  @@map("channel_routes")
}

enum ChannelKind {
  cloud_api
  qr_gateway
}

enum ChannelStatus {
  pending
  connected
  disconnected
  restricted
}

model Service {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  durationMinutes  Int      @map("duration_minutes")
  priceCents       Int      @map("price_cents")
  visibleToPatient Boolean  @default(true) @map("visible_to_patient")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  appointments        Appointment[]         @relation("Appointment_service")
  slotWaitlistEntries SlotWaitlistEntry[]   @relation("SlotWaitlistEntry_service")
  professionals       ProfessionalService[] @relation("ProfessionalService_service")

  @@unique([tenantId, id])
  @@map("services")
}

/// Services a professional performs (spec 05, "Agenda por profissional"). A professional without
/// any row performs every service (H-45).
model ProfessionalService {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  professional Professional @relation("ProfessionalService_professional", fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Cascade)
  service      Service      @relation("ProfessionalService_service", fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, professionalId, serviceId])
  @@index([tenantId, serviceId])
  @@map("professional_services")
}

/// Weekly wall-clock rule, interpreted in the tenant's timezone.
model AvailabilityRule {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  professionalId      String   @map("professional_id") @db.Uuid
  weekday             Int      @db.SmallInt
  startTime           DateTime @map("start_time") @db.Time(0)
  endTime             DateTime @map("end_time") @db.Time(0)
  slotIntervalMinutes Int      @default(0) @map("slot_interval_minutes")
  minNoticeMinutes    Int      @default(120) @map("min_notice_minutes")
  maxAdvanceDays      Int      @default(60) @map("max_advance_days")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  professional Professional @relation("AvailabilityRule_professional", fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, professionalId])
  @@map("availability_rules")
}

model TimeOff {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  professionalId String      @map("professional_id") @db.Uuid
  startsAt       DateTime    @map("starts_at") @db.Timestamptz
  endsAt         DateTime    @map("ends_at") @db.Timestamptz
  reason         String?
  /// RF-14: a vacation is a time off the assistant announces with the return date (endsAt).
  kind           TimeOffKind @default(block)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  professional Professional @relation("TimeOff_professional", fields: [tenantId, professionalId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, professionalId, startsAt])
  @@map("time_off")
}

enum TimeOffKind {
  block
  vacation
}

model Location {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  name                String
  address             String
  arrivalInstructions String?  @map("arrival_instructions")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  appointments Appointment[] @relation("Appointment_location")

  @@unique([tenantId, id])
  @@map("locations")
}

model KnowledgeItem {
  id        String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  question  String
  answer    String?
  source    KnowledgeSource @default(manual)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, active])
  @@map("knowledge_items")
}

enum KnowledgeSource {
  manual
  unanswered
  history
}
