// Platform tables: no tenant_id, no RLS.

model Tenant {
  id                     String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                   String
  slug                   String       @unique
  logo                   String?
  metadata               String?
  plan                   Plan         @default(essencial)
  status                 TenantStatus @default(trial)
  timezone               String       @default("America/Sao_Paulo")
  /// RF-44: a patient cancels at least this long before the appointment (hypothesis: 24 h).
  cancelNoticeMinutes    Int          @default(1440) @map("cancel_notice_minutes")
  /// RF-15: local time of day (minutes after midnight) of the nightly agenda push; default 20:00.
  nightlySummaryMinute   Int          @default(1200) @map("nightly_summary_minute")
  /// Weekly report to the owner (Monday 08:00 local, e-mail and push); counts only. Opt-out in Mais.
  weeklyReport           Boolean      @default(true) @map("weekly_report")
  /// RF-47: minutes before the appointment of each reminder; default 24 h and 2 h.
  reminderOffsetsMinutes Int[]        @default([1440, 120]) @map("reminder_offsets_minutes")
  /// M-09: after a "faltou", ask the client when to reschedule (owner's switch, off by default).
  noShowFollowUp         Boolean      @default(false) @map("no_show_follow_up")
  /// M-11: the short code this business gives to others; created on first use.
  referralCode           String?      @unique @map("referral_code")
  /// M-10: one message to a lead that went quiet (owner's switch, off by default).
  leadFollowUp           Boolean      @default(false) @map("lead_follow_up")
  leadFollowUpDays       Int          @default(2) @map("lead_follow_up_days")
  /// The text the owner approved; null until they confirm one, and nothing is sent while null.
  leadFollowUpText       String?      @map("lead_follow_up_text")
  /// M-12: one review request after "Compareceu" (owner's switch, off by default; needs the review link).
  reviewRequest          Boolean      @default(false) @map("review_request")
  reviewRequestDelayHours Int         @default(3) @map("review_request_delay_hours")
  /// How the assistant introduces itself (spec 04, "Identificação").
  assistantName          String       @default("Assistente virtual") @map("assistant_name")
  /// How the assistant presents itself (owner decision, 24/11/2026; spec 01 "Limites").
  identityMode           IdentityMode @default(assistant) @map("identity_mode")
  /// RF-13: a new client starts approving every answer before it goes out.
  autonomy               Autonomy     @default(approve)
  /// E-18: overage cap in cents, set by the owner; null means no cap (spec 01).
  overageCapCents        Int?         @map("overage_cap_cents")
  specialtyPolicyId      String?      @map("specialty_policy_id") @db.Uuid
  /// E-24: onboarding step -> done|skipped plus the chosen specialty; shape in packages/core.
  onboardingProgress     Json         @default("{}") @map("onboarding_progress")
  /// M-04: business profile (packages, payment methods, contacts...); shape in packages/core.
  businessProfile        Json         @default("{}") @map("business_profile")
  limits                 Json         @default("{}")
  /// S-05 (RF-80): the trial ends here; null = no trial (the pilot). Default set in SQL: created + 14 days.
  trialEndsAt            DateTime?    @map("trial_ends_at") @db.Timestamptz
  /// S-05 (RF-88): when the sweep turned the assistant off; the data is kept 30 days from here.
  trialEndedAt           DateTime?    @map("trial_ended_at") @db.Timestamptz
  /// S-05 (RF-84): each abandonment reminder is sent once; the moment it was claimed.
  reminder1dSentAt       DateTime?    @map("reminder_1d_sent_at") @db.Timestamptz
  reminder3dSentAt       DateTime?    @map("reminder_3d_sent_at") @db.Timestamptz
  /// S-05 (RF-81): CPF or CNPJ, digits only; unique, so one trial per document.
  document               String?
  /// E-25: Asaas ids. The subscription id is null while there is no subscription.
  billingCustomerId      String?      @unique @map("billing_customer_id")
  billingSubscriptionId  String?      @unique @map("billing_subscription_id")
  /// Due date of the oldest unpaid subscription invoice; null = in good standing.
  billingOverdueSince    DateTime?    @map("billing_overdue_since") @db.Timestamptz
  /// Overdue notices already sent (0 to 2); the ladder sends each once.
  billingNoticeStep      Int          @default(0) @map("billing_notice_step")
  /// Link to pay the open invoice, as the provider gave it.
  billingInvoiceUrl      String?      @map("billing_invoice_url")
  /// Due date of the latest paid subscription invoice; a late "overdue" event for older ones is ignored.
  billingPaidDueDate     DateTime?    @map("billing_paid_due_date") @db.Date
  /// First day of the last month whose overage was charged.
  billingOverageThrough  DateTime?    @map("billing_overage_through") @db.Date
  /// Cancelled subscription: the assistant works until here (end of the paid period), then stops.
  billingEndsAt          DateTime?    @map("billing_ends_at") @db.Timestamptz
  /// E-26 (RF-63): when the status became cancelled (set by a trigger); the 30-day deletion clock starts here.
  cancelledAt            DateTime?    @map("cancelled_at") @db.Timestamptz
  /// E-26: when the deletion job erased this tenant's business data; null = not yet.
  dataDeletedAt          DateTime?    @map("data_deleted_at") @db.Timestamptz
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  specialtyPolicy SpecialtyPolicy? @relation(fields: [specialtyPolicyId], references: [id], onDelete: Restrict)

  memberships          Membership[]
  invitations          Invitation[]
  professionals        Professional[]
  channels             Channel[]
  services             Service[]
  availabilityRules    AvailabilityRule[]
  professionalServices ProfessionalService[]
  timeOffs             TimeOff[]
  locations            Location[]
  knowledgeItems       KnowledgeItem[]
  contacts             Contact[]
  conversations        Conversation[]
  messages             Message[]
  inboundEvents        InboundEvent[]
  turns                Turn[]
  appointments         Appointment[]
  scheduledMessages    ScheduledMessage[]
  payments             Payment[]
  slotWaitlistEntries  SlotWaitlistEntry[]
  slotOffers           SlotOffer[]
  aiUsages             AiUsage[]
  metaUsages           MetaMessageUsage[]
  usageCounters        UsageCounter[]
  auditLogs            AuditLog[]
  contactStageEvents   ContactStageEvent[]
  consentEvents        ConsentEvent[]
  clientPackages       ClientPackage[]
  importContacts       ImportContact[]
  importMessages       ImportMessage[]
  packageEntries       PackageEntry[]
  pushSubscriptions    PushSubscription[]
  calendarIntegration  CalendarIntegration?

  @@map("tenants")
}

/// Global catalog of rules per specialty (council rules). Read-only for the app.
model SpecialtyPolicy {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  specialty String   @unique
  rules     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenants Tenant[]

  @@map("specialty_policies")
}

enum Plan {
  essencial
  agenda
  pro
  clinica
}

enum IdentityMode {
  assistant
  clinic
  professional
}

enum Autonomy {
  auto
  approve
  off
}

enum TenantStatus {
  /// Invite-only signup (owner decision, 25/11/2026): created by an onboarding invite, no trial clock
  /// yet. The 14-day trial starts when a channel first connects (trigger on channels, H-24).
  setup
  trial
  active
  restricted
  cancelled
}

/// Platform table (no tenant, no RLS): a visitor of the public site who asked for early access
/// (S-01). Email is stored lowercase; one row per address.
model WaitlistEntry {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email     String   @unique
  name      String?
  specialty String?
  /// M-11: the code of the business that shared the link (valid codes only); attribution, never a contact.
  referralCode String? @map("referral_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([referralCode])
  @@map("waitlist_entries")
}

/// Platform table (no RLS): problems raised by alert() for the operator panel (E-26). Ids and a
/// short code only, never message content (RN-38). tenant_id has no FK: the event outlives the tenant.
model OpsEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  event          String
  tenantId       String?  @map("tenant_id") @db.Uuid
  queue          String?
  jobId          String?  @map("job_id")
  conversationId String?  @map("conversation_id") @db.Uuid
  turnId         String?  @map("turn_id") @db.Uuid
  code           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@map("ops_events")
}

/// Platform table (no RLS): Asaas webhook events already received (E-25). The provider's event id is
/// the key, so a retried delivery is recognised; `processedAt` null means it must be applied again.
model BillingEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  @@map("billing_events")
}
