{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "dependencies": {
    "@app/core": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.9.1"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "migrate:dev": "prisma migrate dev",
