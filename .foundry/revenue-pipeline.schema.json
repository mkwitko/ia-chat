{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mkwitko/Saas-Foundry/schemas/revenue-pipeline.schema.json",
  "title": "SaaS Foundry company-level revenue pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "leads", "channels"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "leads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "organization", "segment", "fit", "pain_evidence", "contact_permission", "stage"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "organization": { "type": "string", "minLength": 1 },
          "website": { "type": ["string", "null"], "format": "uri" },
          "source_url": { "type": ["string", "null"], "format": "uri" },
          "segment": { "type": "string", "minLength": 1 },
          "fit": { "enum": ["high", "medium", "low", "unknown"] },
          "pain_evidence": { "enum": ["observed", "reported", "hypothesis", "unknown"] },
          "buying_role": { "type": ["string", "null"] },
          "contact_permission": { "enum": ["explicit", "unknown", "denied", "not_required"] },
          "permission_basis": { "type": ["string", "null"] },
          "stage": { "enum": ["identified", "researched", "qualified", "permissioned", "contacted", "conversation", "demo", "proposal", "won", "lost", "disqualified"] },
          "next_action": { "type": ["string", "null"] },
          "next_action_due": { "type": ["string", "null"], "format": "date" },
          "stage_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "entered_at"],
              "properties": {
                "stage": { "enum": ["identified", "researched", "qualified", "permissioned", "contacted", "conversation", "demo", "proposal", "won", "lost", "disqualified"] },
                "entered_at": { "type": "string", "format": "date-time" }
              }
            }
          },
          "notes": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "contact_permission": { "const": "not_required" } },
              "required": ["contact_permission"]
            },
            "then": {
              "required": ["permission_basis"],
              "properties": { "permission_basis": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "channel", "hypothesis", "status", "primary_metric"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "minLength": 1 },
          "hypothesis": { "type": "string", "minLength": 1 },
          "status": { "enum": ["proposed", "running", "completed", "stopped"] },
          "primary_metric": { "type": "string", "minLength": 1 },
          "result": { "type": ["string", "null"] }
        }
      }
    }
  }
}
