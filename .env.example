# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
# Host port of the docker-compose Postgres. Change it here and in the URLs if 5432 is taken.
POSTGRES_PORT=5432
# App role: no BYPASSRLS, owns no table (RN-02).
DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:5432/app
# Owner role, used only by migrations.
MIGRATION_DATABASE_URL=postgres://app_migrator:app_migrator@127.0.0.1:5432/app

# API (E-04)
PORT=3000
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Panel origin, trusted by auth.
WEB_ORIGIN=http://localhost:5173
# Google login and Google Calendar (E-00c, E-21), optional until the Google Cloud project exists.
# The same OAuth client serves both; authorize BETTER_AUTH_URL + /api/calendar/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the Google tokens at rest (AES-256-GCM, spec 06): openssl rand -base64 32
# Without the three Google variables the Calendar integration is off (the agenda keeps its own rules).
GOOGLE_TOKEN_KEY=
# WhatsApp Cloud API (E-09). Without both, the webhook route is off.
# META_APP_SECRET: Meta app > Settings > Basic > App secret. Signs every webhook.
META_APP_SECRET=
# META_VERIFY_TOKEN: any long random string; type the same in the Meta app webhook setup.
META_VERIFY_TOKEN=
# META_ACCESS_TOKEN: system user token that sends messages. Empty in development: the worker logs instead of sending.
META_ACCESS_TOKEN=
# Embedded Signup, the "Conectar WhatsApp" button (E-24). Without these three plus META_APP_SECRET
# the button is hidden. Each client's number then sends with its own token; META_ACCESS_TOKEN
# stays as the fallback for our own test or pilot number.
# META_APP_ID: Meta app > Settings > Basic > App ID. Public: the panel loads it into the Facebook SDK.
META_APP_ID=
# META_ES_CONFIG_ID: Facebook Login for Business > Configurations > the WhatsApp Embedded Signup configuration id.
META_ES_CONFIG_ID=
# META_TOKEN_KEY: encrypts each client's Meta token at rest: openssl rand -base64 32
META_TOKEN_KEY=
# Web Push (E-16): notifies the professional of urgencies, handoffs and drafts. Optional in
# development (without them the notice is only logged); required in production.
# Generate the pair once: pnpm --filter @app/worker exec web-push generate-vapid-keys
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# PUSH_SUBJECT: a contact for the push services, e.g. mailto:contato@seudominio.com.br
PUSH_SUBJECT=

# AI (E-06). All models go through the Vercel AI Gateway with one key.
VERCEL_API_KEY=
# Jev (TypeSafe), outside the gateway.
TYPESAFE_API_KEY=
# Optional JSON with per-task route overrides, e.g. {"conversation":{"primary":{"provider":"openai","model":"gpt-6-luna"}}}
# AI_DEV_PROVIDER=groq: free Groq models for local development (never in production).
# GROQ_API_KEY: console.groq.com > API Keys.
AI_DEV_PROVIDER=
GROQ_API_KEY=
AI_ROUTES=
# Langfuse (traces with name and phone masked).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Observability (E-26, docs/observabilidade.md). Each one lights up only when set.
# SENTRY_DSN: errors of api and worker. VITE_SENTRY_DSN: errors of the panel (read at build time).
SENTRY_DSN=
VITE_SENTRY_DSN=
# Release tag on errors (a commit SHA); VITE_RELEASE is the same for the panel build.
APP_RELEASE=
VITE_RELEASE=
# Axiom log shipping needs both; otherwise logs go to stdout only.
AXIOM_TOKEN=
AXIOM_DATASET=
# LOG_LEVEL: trace, debug, info (default), warn, error.
LOG_LEVEL=
# Worker readiness: GET /ready on this port. Empty = off.
WORKER_HEALTH_PORT=

# Public site and waitlist (S-01). Without SITE_ORIGIN and TURNSTILE_SECRET_KEY the /api/waitlist route is off.
# SITE_ORIGIN: where apps/site is served (the only origin CORS allows on that route).
# TURNSTILE_SECRET_KEY / PUBLIC_TURNSTILE_SITE_KEY: Cloudflare dashboard > Turnstile. The values below are
# Cloudflare official TEST keys (always pass): fine for development, replace in production.
SITE_ORIGIN=http://localhost:4321
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Read by apps/site at build time (Astro exposes PUBLIC_ variables to the browser).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_API_URL=http://localhost:3000

# Platform operators (E-27): comma-separated emails allowed on /api/operator/*. Empty = nobody.
# Support channels in the panel's "Ajuda e suporte" (S-07). Each one is hidden when empty.
# SUPPORT_WHATSAPP: digits with country code, e.g. 5511999999999.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
OPERATOR_EMAILS=

# Help center (S-06). Public URL of the site's help center; the panel "Ajuda" item links to it.
# Read by apps/web at build time (only VITE_ variables reach the browser). Empty hides the link.
VITE_HELP_URL=http://localhost:4321/ajuda

# Subscription billing (E-25, Asaas). Without ASAAS_API_KEY billing is off (panel says so, nothing is charged).
# ASAAS_API_KEY: Asaas sandbox key (sandbox.asaas.com > Integrações) in development; production key only in production.
# ASAAS_BASE_URL: sandbox https://api-sandbox.asaas.com/v3 (default when empty) or https://api.asaas.com/v3.
# ASAAS_WEBHOOK_TOKEN: a long random value (>= 32 chars) that you also set as the "Token de autenticação" of the
# Asaas webhook pointed at POST /webhooks/asaas; without it the webhook route is off. Generate: openssl rand -hex 24
ASAAS_API_KEY=
ASAAS_BASE_URL=
ASAAS_WEBHOOK_TOKEN=

# Patient media (E-10, Cloudflare R2). Without all of them inbound media is not downloaded: audio is not
# transcribed and the panel shows "mídia indisponível". Create a bucket and an R2 API token (Object Read & Write).
# R2_ENDPOINT is optional: it defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_MEDIA_BUCKET=
# Transactional email (Resend, domain verified there). Required in production; empty in development logs emails.
RESEND_API_KEY=
# Development/test never send real email (only the log), even with the key above, unless this is true.
EMAIL_SEND_IN_DEV=
# Production only (docker-compose.prod.yml, docs/ops/producao.md). Ignored in development.
# Hostnames the edge (Caddy, plain HTTP) serves behind the Cloudflare Tunnel. The api lives under the panel
# (/api, /webhooks); www.SITE_DOMAIN redirects to SITE_DOMAIN. The tunnel token goes in .env.tunnel (TUNNEL_TOKEN=).
PANEL_DOMAIN=
SITE_DOMAIN=
# Images from GHCR, e.g. ghcr.io/<owner>/<repo>; empty builds on the server. IMAGE_TAG: a commit SHA or "latest".
IMAGE_PREFIX=
IMAGE_TAG=
# In production DATABASE_URL and MIGRATION_DATABASE_URL use the host "postgres" and the passwords of .env.db
# (copy .env.db.example): postgres://app_runtime:<APP_RUNTIME_PASSWORD>@postgres:5432/app
