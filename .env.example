# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
# Host port of the docker-compose Postgres. Change it here and in the URLs if 5432 is taken.
POSTGRES_PORT=5432
# App role: no BYPASSRLS, owns no table (RN-02).
DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:5432/app
# Owner role, used only by migrations.
MIGRATION_DATABASE_URL=postgres://app_migrator:app_migrator@127.0.0.1:5432/app

# API (E-04)
PORT=3000
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Panel origin, trusted by auth.
WEB_ORIGIN=http://localhost:5173
# Google login, optional until the Google Cloud project exists (E-00c).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WhatsApp Cloud API (E-09). Without both, the webhook route is off.
# META_APP_SECRET: Meta app > Settings > Basic > App secret. Signs every webhook.
META_APP_SECRET=
# META_VERIFY_TOKEN: any long random string; type the same in the Meta app webhook setup.
META_VERIFY_TOKEN=

# AI (E-06). All models go through the Vercel AI Gateway with one key.
VERCEL_API_KEY=
# Jev (TypeSafe), outside the gateway.
TYPESAFE_API_KEY=
# Optional JSON with per-task route overrides, e.g. {"conversation":{"primary":{"provider":"openai","model":"gpt-6-luna"}}}
AI_ROUTES=
# Langfuse (traces with name and phone masked).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
