{
  "name": "recepcao-inteligente",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json && pnpm --filter @app/site exec astro sync && tsc -p apps/site/tsconfig.json",
    "site:dev": "pnpm --filter @app/site dev",
    "site:build": "pnpm --filter @app/site build",
    "test": "vitest run",
    "audit": "pnpm audit --audit-level moderate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit",
    "db:migrate": "pnpm --filter @app/db migrate:deploy",
    "db:seed": "pnpm --filter @app/db seed",
    "ai:smoke": "pnpm --filter @app/ai smoke",
    "eval": "pnpm --filter @app/ai eval",
    "web:dev": "pnpm --filter @app/web dev",
    "dev:patient": "node --env-file-if-exists=.env apps/api/scripts/simulate-patient.ts",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:worker": "pnpm --filter @app/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
