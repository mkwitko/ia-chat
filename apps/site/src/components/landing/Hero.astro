---
import HeroBoard from './HeroBoard.astro';
// Section 1 (founder/landing-brief.md): the promise, the action, the three conditions, and the
// hour that proves it.
const terms = ['14 dias grátis', 'sem taxa de implantação', 'sem fidelidade'] as const;
---

<section class="hero-l" aria-labelledby="titulo">
  <div class="wrap head">
    <h1 id="titulo">Seu WhatsApp responde e marca na sua agenda enquanto você atende.</h1>
    <div class="side">
      <p class="support">No mesmo número. Nada sai sem você aprovar, até você querer.</p>
      <div class="cta">
        <a class="btn" href="#convite">Pedir convite</a>
        <a class="more" href="/precos">Ver preços</a>
      </div>
      <ul class="terms" aria-label="Condições">
        {
          terms.map((term) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" />
              </svg>
              {term}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="wrap">
    <HeroBoard />
  </div>
</section>

<style>
  .hero-l {
    padding: 32px 0 8px;
  }
  .head {
    display: grid;
    gap: 20px;
    margin-bottom: 32px;
  }
  h1 {
    font-size: clamp(38px, 10vw, 72px);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }
  .support {
    margin: 0;
    font-size: clamp(18px, 1.6vw, 20px);
    line-height: 1.45;
    color: var(--ink-2);
    max-width: 34ch;
  }
  .cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 20px;
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
  }
  .terms {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  .terms li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .terms svg {
    flex: none;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (min-width: 960px) {
    .hero-l {
      padding: 40px 0 16px;
    }
    .head {
      grid-template-columns: minmax(0, 9fr) minmax(0, 3fr);
      align-items: end;
      gap: 48px;
      margin-bottom: 32px;
    }
    .terms {
      flex-direction: column;
    }
  }
</style>
