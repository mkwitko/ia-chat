---
import './hero-board.css';
import { HERO_BOOKING as B, PILOT_SERVICE as S } from '../../lib/sample-day-fixtures.ts';
import { formatBrl } from '../../lib/money.ts';
// One hour on two lanes (founder/landing-brief.md, section 1): you are in the treatment room while
// the assistant answers on WhatsApp and books in Google Agenda. Service and price are the pilot's
// real ones (owner, 26/11/2026); patient and conversation are illustrative, and labelled as such.
// CSS-only sequence in hero-board.css; with reduced motion everything is shown at once.
const price = formatBrl(S.priceCents);
const slot = `${B.weekdayShort} ${B.start}–${B.end}`;
const offer = `Oi, ${B.patient}! A ${S.name.toLowerCase()} (${S.detail}) custa ${price} e dura ${String(S.minutes)} minutos. Amanhã tenho ${B.start} ou ${B.alternative}. Qual fica melhor?`;
const confirmation = `Combinado: amanhã, ${B.weekday}, das ${B.start} às ${B.end}. Te lembro um dia antes.`;
---

<figure class="board" aria-labelledby="board-cap">
  <figcaption id="board-cap">
    <span class="hour">Quarta, das 15:00 às 16:00</span>
    <span class="tag">Serviço e preço reais do consultório piloto. Conversa ilustrativa.</span>
  </figcaption>
  <div class="lanes">
    <p class="lane l-you" aria-hidden="true">Você</p>
    <p class="lane l-wa" aria-hidden="true">WhatsApp do consultório</p>
    <p class="lane l-ag" aria-hidden="true">Google Agenda</p>

    <div class="busy-bar" aria-hidden="true"></div>
    <p class="busy">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <rect x="4.5" y="1.5" width="7" height="13" rx="1.5"></rect>
        <path d="M2 2l12 12"></path>
      </svg>
      <span><strong>Você, em atendimento</strong> · celular no bolso</span>
    </p>

    <div class="ev in e1" style="--d: 0.5s">
      <time>15:12</time>
      <p class="bubble">
        <span class="sr-only">Paciente:</span>Oi! Quanto é a primeira consulta? Tem horário amanhã?
      </p>
    </div>
    <div class="ev out e2" style="--d: 1.6s">
      <time>15:12</time>
      <p class="bubble">
        <b>Assistente</b>{offer}
      </p>
    </div>
    <div class="ev in e3" style="--d: 2.8s">
      <time>15:14</time>
      <p class="bubble"><span class="sr-only">Paciente:</span>15h, por favor</p>
    </div>
    <div class="ev out e4" style="--d: 3.8s">
      <time>15:14</time>
      <p class="bubble">
        <b>Assistente</b>{confirmation}
      </p>
    </div>
    <div class="slot e5" aria-hidden="true"><time>{slot}</time>livre</div>
    <p class="booked e5" style="--d: 4.4s">
      <span class="sr-only">Google Agenda:</span>
      <time>{slot}</time>
      <strong>{S.name} · {B.patientFull}</strong>
      <small>marcado pelo assistente</small>
    </p>
    <p class="end" style="--d: 5.2s">
      <time>16:00</time>
      <strong>Você sai da sala.</strong>
      <span>Nenhuma mensagem esperando. A {B.patient} já está na agenda.</span>
    </p>
  </div>
</figure>
