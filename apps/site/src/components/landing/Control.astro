---
// Section 4: the approval card, from a real panel screenshot with fictitious data. Each verb is
// keyed by number to where its button sits on the screenshot (positions in % of the image).
const verbs = [
  { name: 'Enviar', text: 'A resposta está certa: sai como está.', x: 6.5, y: 75.8 },
  { name: 'Editar', text: 'Ajuste uma palavra e envie com o seu jeito.', x: 29.5, y: 75.8 },
  { name: 'Descartar', text: 'Não sai nada. Você responde do seu jeito.', x: 52, y: 75.8 },
  { name: 'Assumir', text: 'Qualquer conversa, com um toque. O assistente para ali.', x: 71.5, y: 9.8 },
] as const;
---

<section class="control wrap" aria-labelledby="controle">
  <div class="text">
    <h2 id="controle">Nos primeiros dias, cada resposta espera o seu toque.</h2>
    <p class="lead">
      O assistente escreve o rascunho e nada vai para o paciente até você decidir. Quando quiser,
      deixa automático.
    </p>
    <ol class="verbs">
      {
        verbs.map((verb, i) => (
          <li>
            <span class="key" aria-hidden="true">{i + 1}</span>
            <strong>{verb.name}</strong>
            <span class="what">{verb.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
  <figure class="shot">
    <div class="frame">
      <picture>
        <source srcset="/img/painel-aprovacao-escuro.webp" media="(prefers-color-scheme: dark)" />
        <img
          src="/img/painel-aprovacao-claro.webp"
          width="600"
          height="1200"
          loading="lazy"
          decoding="async"
          alt="Tela do painel no celular: o paciente João Exemplo pergunta quanto custa a avaliação; abaixo, o rascunho do assistente com o preço e os botões Enviar, Editar e Descartar, e no topo o botão Assumir."
        />
      </picture>
      {
        verbs.map((verb, i) => (
          <span class="key pin" aria-hidden="true" style={`left:${String(verb.x)}%;top:${String(verb.y)}%`}>
            {i + 1}
          </span>
        ))
      }
    </div>
    <figcaption>Tela real do painel, com dados fictícios.</figcaption>
  </figure>
</section>

<style>
  .control {
    display: grid;
    gap: 40px;
    padding-top: 96px;
  }
  h2 {
    font-size: clamp(28px, 4.4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 18ch;
  }
  .lead {
    margin: 16px 0 0;
    font-size: 18px;
    line-height: 28px;
    color: var(--ink-2);
    max-width: 44ch;
  }
  .verbs {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .verbs li {
    display: grid;
    grid-template-columns: 24px 1fr;
    align-items: start;
    gap: 2px 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .what {
    grid-column: 2;
    color: var(--ink-2);
  }
  .key {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--action);
    color: var(--action-ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
  }
  .shot {
    margin: 0;
    justify-self: center;
    width: min(100%, 300px);
  }
  .frame {
    position: relative;
    border: 9px solid #111214;
    border-radius: 40px;
    aspect-ratio: 1 / 2;
    background: var(--surface);
    box-shadow:
      0 2px 4px rgb(17 18 20 / 10%),
      0 32px 64px -24px rgb(17 18 20 / 35%);
  }
  @media (prefers-color-scheme: dark) {
    .frame {
      border-color: #2a2a2f;
    }
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 31px;
    object-fit: cover;
    object-position: top;
  }
  .pin {
    position: absolute;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 3px var(--bg);
  }
  figcaption {
    margin-top: 12px;
    text-align: center;
    font-size: 13px;
    color: var(--ink-2);
  }
  @media (min-width: 960px) {
    .control {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: 48px;
      padding-top: 144px;
    }
    .shot {
      width: min(100%, 340px);
    }
    .verbs li {
      grid-template-columns: 24px 112px 1fr;
      gap: 16px;
    }
    .what {
      grid-column: 3;
    }
  }
</style>
