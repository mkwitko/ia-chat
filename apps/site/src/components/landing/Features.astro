---
// Sections 6 and 7: what exists today (nothing "em breve" here) and privacy.
const features = [
  { title: 'Responde na hora', text: 'A qualquer hora, inclusive às 21h e no fim de semana.' },
  { title: 'Marca no Google Agenda', text: 'Marca, remarca e cancela olhando os seus horários livres.' },
  { title: 'Lembra o paciente', text: 'Um dia antes e duas horas antes da consulta.' },
  { title: 'Entende áudio', text: 'O paciente manda áudio, o assistente entende e responde.' },
  { title: 'Chama você', text: 'Avisa no seu celular quando a conversa precisa de você.' },
] as const;
---

<section class="features wrap" aria-labelledby="faz">
  <h2 id="faz">O que o assistente faz hoje.</h2>
  <ul>
    {
      features.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))
    }
  </ul>
  <p class="contrast">
    A mensagem automática do WhatsApp Business só avisa que você vai responder. Ela não marca nem
    lembra.
  </p>
</section>

<section class="privacy wrap" aria-labelledby="privacidade">
  <h2 id="privacidade">A queixa do paciente fica só na conversa.</h2>
  <div>
    <p>
      Ela não entra em cadastro nem em relatório. Os dados dos seus pacientes ficam com você, não
      são usados para treinar modelos de IA, e cada consultório vê só os seus.
    </p>
    <p class="links">
      <a href="/privacidade">Política de Privacidade</a>
      <a href="/contrato-de-operador">Contrato de Operador (LGPD)</a>
    </p>
  </div>
</section>

<style>
  .features {
    padding-top: 96px;
  }
  h2 {
    font-size: clamp(28px, 4.4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 32px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  li {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  h3 {
    margin: 0 0 4px;
    font-size: 19px;
  }
  li p {
    margin: 0;
    color: var(--ink-2);
  }
  .contrast {
    margin: 24px 0 0;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .privacy {
    display: grid;
    gap: 8px;
    padding-top: 96px;
  }
  .privacy p {
    margin: 0;
    font-size: 18px;
    line-height: 28px;
    color: var(--ink-2);
    max-width: 56ch;
  }
  .privacy .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin-top: 12px;
    font-size: 16px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
  }

  @media (min-width: 720px) {
    ul {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 32px;
    }
  }
  @media (min-width: 960px) {
    .features {
      padding-top: 144px;
    }
    ul {
      grid-template-columns: repeat(5, 1fr);
      border-top: 0;
    }
    li {
      border-bottom: 0;
      border-top: 1px solid var(--line-strong);
      padding-top: 16px;
    }
    .privacy {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 48px;
      padding-top: 144px;
      align-items: start;
    }
    .privacy h2 {
      margin: 0;
    }
  }
</style>
