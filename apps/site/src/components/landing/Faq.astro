---
import { FAQS } from '../../lib/faq.ts';

// Section 9: the remaining objections. The heading column stays in view on wide screens and
// says where to go when the question is not here. Opening animates with CSS only.
const CONTACT = 'mauriciokwt@gmail.com';
---

<section class="faq wrap" aria-labelledby="perguntas">
  <div class="aside">
    <h2 id="perguntas">Perguntas</h2>
    <p>
      Não achou a sua? Veja a <a href="/ajuda">Central de ajuda</a> ou escreva para{' '}
      <a href={`mailto:${CONTACT}`}>{CONTACT}</a>. Quem responde é quem constrói.
    </p>
  </div>
  <div class="list">
    {
      FAQS.map((faq) => (
        <details name="faq">
          <summary>
            <span>{faq.question}</span>
            <i aria-hidden="true" />
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    padding-top: 96px;
  }
  h2 {
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 12px;
  }
  .aside p {
    margin: 0 0 24px;
    color: var(--ink-2);
    max-width: 36ch;
  }
  .aside a {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .list {
    border-top: 1px solid var(--line-strong);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    padding: 18px 0;
    min-height: 64px;
    font-size: 18px;
    line-height: 26px;
    letter-spacing: -0.01em;
  }
  summary::after {
    display: none;
  }
  summary:hover span {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  /* A plus that turns into a minus. */
  i {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }
  i::before,
  i::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 11px;
    height: 1.75px;
    margin: -0.875px 0 0 -5.5px;
    background: var(--ink);
    border-radius: 1px;
    transition: transform 260ms var(--ease-out);
  }
  i::after {
    transform: rotate(90deg);
  }
  details[open] i::after {
    transform: rotate(0deg);
  }
  details[open] i {
    background: var(--surface-2);
  }
  details p {
    padding: 0 44px 24px 0;
    font-size: 17px;
    line-height: 27px;
    max-width: 62ch;
  }
  /* Smooth open/close where the browser supports animating to auto height. */
  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      block-size: 0;
      overflow: hidden;
      opacity: 0;
      transition:
        block-size 320ms var(--ease-out),
        opacity 240ms var(--ease-out),
        content-visibility 320ms allow-discrete;
    }
    details[open]::details-content {
      block-size: auto;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    details::details-content,
    i::after {
      transition: none;
    }
  }

  @media (min-width: 960px) {
    .faq {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 48px;
      align-items: start;
      padding-top: 144px;
    }
    .aside {
      position: sticky;
      top: 96px;
    }
    summary {
      font-size: 20px;
      line-height: 28px;
      min-height: 72px;
    }
  }
</style>
