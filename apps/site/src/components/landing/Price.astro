---
import { PLANS, PlanId } from '@app/core';
import { formatBrlShort, formatCount } from '../../lib/money.ts';
import { PLAN_NAMES } from '../../lib/plans-view.ts';
import MonthBill from '../MonthBill.astro';
import './price.css';

// Section 8: open price, Agenda featured, and the example month with Meta added. Plans sit on
// hairlines like the hero's lanes; the month is a ruler split between the plan and Meta.
const plans = [
  { id: PlanId.agenda, does: 'Responde, marca no Google Agenda e lembra.' },
  { id: PlanId.essencial, does: 'Responde e passa a conversa para você.' },
].map((plan) => ({
  ...plan,
  name: PLAN_NAMES[plan.id],
  price: formatBrlShort(PLANS[plan.id].monthlyCents),
  franchise: formatCount(PLANS[plan.id].franchise),
}));
const terms = ['14 dias grátis', 'sem taxa de implantação', 'sem fidelidade'] as const;
---

<section class="pricing wrap" aria-labelledby="preco">
  <h2 id="preco">Preço aberto. Sem taxa de implantação.</h2>
  <div class="layout">
    <div class="plans">
      {
        plans.map((plan, index) => (
          <article class:list={['plan', { main: index === 0 }]}>
            <h3>{plan.name}</h3>
            <p class="amount">
              <span class="n">{plan.price}</span>
              <span class="per">/mês</span>
            </p>
            <p class="does">
              {plan.does} <span class="fr">{plan.franchise} conversas por mês.</span>
            </p>
          </article>
        ))
      }
      <a class="all" href="/precos">
        Ver os quatro planos e a comparação
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
      </a>
    </div>

    <MonthBill>
      <ul class="terms" aria-label="Condições">
        {
          terms.map((term) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" />
              </svg>
              {term}
            </li>
          ))
        }
      </ul>
      <a class="btn" href="#convite">Pedir convite</a>
    </MonthBill>
  </div>
</section>
